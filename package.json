{
  "name": "classroom",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @classroom/db generate",
    "db:migrate": "pnpm --filter @classroom/db migrate",
    "db:push": "pnpm --filter @classroom/db push",
    "db:seed": "pnpm --filter @classroom/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
