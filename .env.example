# Copy to .env at the repo root. Loaded by apps/web, apps/realtime, and @classroom/db.

# --- Postgres (matches docker-compose.yml) ---
# POSTGRES_PORT overrides the host port if 5432 is already taken; keep DATABASE_URL in sync.
# POSTGRES_PORT="5432"
DATABASE_URL="postgresql://classroom:classroom@localhost:5432/classroom"

# --- Auth.js (shared by apps/web and apps/realtime) ---
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# --- Realtime (Socket.IO server) ---
REDIS_URL="redis://localhost:6379"
REALTIME_PORT="4000"
# URL the web client dials for the socket server.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
# The web app's own origin — apps/realtime's CORS allowlist pins to this (no wildcard).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Object storage for slide uploads (#13, matches docker-compose.yml MinIO) ---
# In prod, point these at a real S3-compatible bucket (endpoint/creds differ; deferred host decision).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="classroom"
S3_ACCESS_KEY_ID="classroom"
S3_SECRET_ACCESS_KEY="classroom"
# Path-style addressing — required by MinIO and most S3-compatibles.
S3_FORCE_PATH_STYLE="true"
# MINIO_PORT / MINIO_CONSOLE_PORT override the host ports if 9000/9001 are taken.
